<IfModule mod_rewrite.c>
    RewriteEngine On

    # Remove index.php explicitamente da URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+/)?index\.php/([^\s\?]+) [NC]
    RewriteRule ^index\.php/(.*)$ $1 [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+/)?index\.php/?(\?[^\s]*)?\s [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]

    # Se o arquivo ou pasta física existir no diretório, serve diretamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Caso contrário, redireciona amigavelmente para o index.php mantendo o PATH_INFO
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
